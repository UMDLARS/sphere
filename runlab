#!/usr/bin/bash
# specify labname and options
function usage {
    echo $(basename $0) [-o] [-f foldername] labname
    echo -e "\t-o look for scripts and info in /organization folder"
    echo -e "\t-f look for scripts and info in the specified folder"
    return
}

OPTSTRING=":of:"

if [ $# -lt 1 ] ; then
   usage
   exit 1;
fi
lab=${@: -1} 
labpath="/home/umdclasscdxx/.education/$lab"
while getopts ${OPTSTRING} opt; do
   case ${opt} in
      o)
	labpath="/organization/$lab"
	;;
      f)
	labpath=${OPTARG}
	;;
      ?)
        echo "Invalid option =${OPTARG}"
        usage
        exit 1
	;;
    esac
done
for n in `cat $labpath/nodes` ; do
    scp -o StrictHostKeyChecking=no -r $labpath/$n $n:/tmp
    ssh -o StrictHostKeyChecking=no $n "cd /tmp/$n; echo `whoami` > user"
    ssh -o StrictHostKeyChecking=no $n "cd /tmp/$n; sudo bash install" &
done

# Wait for every backgrounded per-node install above to actually
# finish before this script exits. Without this, runlab returns your
# prompt the instant all the ssh commands are LAUNCHED, not when
# they're done - the remote installs (eve's especially, with its long
# package loop) keep running for real afterward, with their output
# still landing on this same terminal well after you've gotten your
# prompt back. That's what looked like a hang needing an Enter press:
# it was background output overwriting an already-returned prompt
# line, not the script actually being stuck.
wait
echo ">>> All node installs finished."
