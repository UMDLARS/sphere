#!/usr/bin/bash

function usage {
    echo $(basename $0) [-n expname] [-o] [-p projname] [-P projname] [-f folder][-m modelfile][-s] labname
    echo -e "\t-n assign the given name to the experiment, instead of labname"
    echo -e "\t-o look for model in /organization folder"
    echo -e "\t-p create an experiment in the given project"
    echo -e "\t-P look for model file in the given project"
    echo -e "\t-f look for model file in the given folder"
    echo -e "\t-m use specified model file"
    echo -e "\t-s set up nodes for the lab after the experiment is ready"
    return
}

OPTSTRING=":n:op:P:f:m:s"

# specify labname, assume password is stored in pass.txt file or $PASSWORD 
if [ $# -lt 1 ] ; then
    usage
    exit 1
fi

SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )


user=$(whoami)
proj=$user
lab=${@: -1} 
exp=$lab
run=0
labpath="/home/$user/.education"
modelfile=$labpath/$lab/$lab.model
org=""
while getopts ${OPTSTRING} opt; do    
  case ${opt} in
      o)
	org="-o"
	labpath="/organization"
	if [ $exp == $lab ] ; then
	    exp=$lab$user
	fi
	modelfile=$labpath/$lab/$lab.model
	;;
    n)
	exp=${OPTARG}
	;;
    p)
	proj=${OPTARG}
	;;
    P)
	Proj=${OPTARG}
	labpath="/project/"$Proj
	modelfile=$labpath/$lab/$lab.model
	;;
    f)
	labpath=${OPTARG}
	modelfile=$labpath/$lab/$lab.model
 	;;
    m) 
	modelfile=${OPTARG}
	;;
    :)
	echo "Option ${OPTARG} requires an argument"
	usage
	exit 1
	;;
    s)
	run=1
	;;
    ?)
        echo "Invalid option =${OPTARG}"
        usage
        exit 1
	;;
    esac
done
echo "Path $labpath lab $lab name $exp proj $proj modelfile $modelfile";

PATH=$PATH:/share

# load util functions
. $SCRIPT_DIR/functions
if [[ "$modelfile" == "/home/$user/.education"* ]]; then
	checklab $labpath $lab
else
	checkmodel $modelfile
fi
DEBUG=${DEBUG:-0}
RETRYSLEEP=3

# we require jq for mrg output parsing.
type jq >&/dev/null 
if [[ $? -ne 0 ]]; then
    echo Installing jq utility
    sudo apt update 
    sudo apt install -y jq
    
    type jq >&/dev/null 
    if [[ $? -ne 0 ]]; then
        echo Error installing jq.
        exit 1
    fi
fi

if [ -e $HOME/pass.txt ]; then
    pass=$(cat $HOME/pass.txt)
else
    pass=${PASSWORD}
fi

if [[ -z $pass ]]; then
    echo Password not set. Please create $HOME/pass.txt or set environment variable \$PASSWORD.
    exit 1
fi

mrg config set server grpc.sphere-testbed.net

echo Logging $user into Merge
mrg login $user -p $pass
if [[ $? -ne 0 ]]; then 
    echo Error logging in.
    exit 1
fi

#
# confirm the experiment is there and ready to be realized.
# if not, then create it and push the model.
#

mrg show exp $exp.$proj &>/dev/null
if [ $? -ne 0 ]; then 
    echo Creating experiment $exp.$proj
    mrg new experiment $exp.$proj
    if [[ $? -ne 0 ]]; then 
        echo Error creating new experiment.
        exit 1
    fi
fi

# See if the realization exists. If so get the revision hash.
isrlz=0
rev=$(mrg list realization -j | jq --arg PROJ $proj --arg EXP $exp -r '.results[].realization | select(.eid == $EXP and .pid == $PROJ) | .xhash')
if [[ -z $rev ]]; then

    echo No existing realization found.
    sleep 60
    echo Pushing new model.
    rev=$(mrg push $modelfile $exp.$proj | head -1 | awk '{print $4}')
    sleep 2
    mrg show revision $exp.$proj $rev
    if [[ $? -ne 0 ]]; then 
        echo Error compiling model.
        exit 1
    fi
else
    isrlz=1
fi

echo Reading $lab model \(revision $rev\)

# realize the revision if needed. 
mzid=real.$exp.$proj
if [[ $isrlz -eq 0 ]]; then 

    echo Realizing model.
    mrg realize $mzid revision $rev
    if [[ $? -ne 0 ]]; then
        echo Error realizing the model. There may not be available testbed resources. Please check with your TA or professor. 
        exit 1
    fi
    sleep 3 # give it a bit

    # confirm it succeeded.
    # ideally the success would be in JSON format, but it is not. So we grep output from a mrg command.
    out=$(mrg list real | grep $mzid)
    if [[ $? -ne 0 ]]; then
        echo Realization does not exist. Please check with your TA or professor. 
        exit 1;
    fi

    echo $out | grep Succeeded &>/dev/null 
    if [[ $? -ne 0 ]]; then
        echo Realization did not succeed. Please check with your TA or professor. 
        exit 1;
    fi
else 
    echo Model is already realized.
fi

# Attempts to materialize the given mzid.
materialize_mzid() {
    local mzid=$1
    local max_tries=3
    local attempt=1
    local out rc

    while [[ $attempt -le $max_tries ]]; do
        echo "Materializing $mzid (attempt $attempt of $max_tries)..."
        out=$(mrg materialize $mzid 2>&1)
        rc=$?
        # filter cosmetic "jq: error ..." noise from the echoed output; 
        # detection below still uses the full, unfiltered $out.
        echo "$out" | grep -v "^jq: error"

        # Clean success: zero exit code and no error text in the output.
        if [[ $rc -eq 0 ]] && ! echo "$out" | grep -q "ERRO"; then
            return 0
        fi

        echo "Materialize reported an error (attempt $attempt of $max_tries). Waiting 10 seconds before retrying..."
        sleep 10
        attempt=$(( attempt + 1 ))
    done

    echo "Error: Materialization of $mzid still reports an error after $max_tries attempts."
    return 1
}

# See if the realization is materialized.
remat=0  # is this a new mtz? If so we may need to reattach the XDC.
mrg show materialization $mzid &>/dev/null
if [[ $? -ne 0 ]]; then 
    echo Materializing model

    materialize_mzid $mzid
    if [[ $? -ne 0 ]]; then 
        echo Error materializing the model. Please retry. If it fails more than twice, check with your TA or professor.
        # do we want to relinquish here? 
        exit 1
    fi

    remat=1
fi

# confirm materialization is there and ready.
mrg show materialization $mzid
if [[ $? -ne 0 ]]; then
    echo Cannot confirm materialization is active.
    exit 1
fi

echo Checking materialization status...
status=nope
tries=0
while [[ $success != Success && tries -le 40 ]]; do

    status=$(mrg show materialization $mzid -j -S | jq -r .taskStatus.HighestStatus)
    echo Materialization status: $status
    if [[ $status == Success ]]; then
        break
    fi
    sleep 6
    tries=$(( tries+1 ))
done

if [[ $status != Success ]]; then 
    echo Materialization was not successful. Status: $status
    echo Please contact your professor, TA, or Merge testbed OPs. 
    # may as well demtz?
    mrg dematerialize $mzid
    exit 1
fi

# Attempts to attach the given XDC to the given materialization.
attach_xdc() {
    local xdc=$1
    local mzid=$2
    local max_tries=3
    local attempt=1
    local out rc attached_val

    while [[ $attempt -le $max_tries ]]; do
        echo "Attaching XDC $xdc to $mzid (attempt $attempt of $max_tries)..."
        out=$(mrg xdc attach $xdc $mzid 2>&1)
        rc=$?

        # filter cosmetic "jq: error ..." noise from the echoed output; 
        # detection below still uses the full, unfiltered $out.
        echo "$out" | grep -v "^jq: error"

        # mrg reports the XDC isn't ready yet -- this means it's already
        # attached to $mzid, so we're done.
        if echo "$out" | grep -q "FailedPrecondition" && echo "$out" | grep -qi "XDC not ready yet"; then
            echo "XDC $xdc is already attached to $mzid."
            return 0
        fi

        # Clean success: zero exit code and no error text in the output.
        if [[ $rc -eq 0 ]] && ! echo "$out" | grep -q "ERRO"; then
            return 0
        fi

        # Otherwise the attach reported an error. Wait a few seconds and
        # check whether the attachment actually went through anyway.
        echo "Attach reported an error. Waiting 5 seconds to check actual attachment status..."
        sleep 5

        attached_val=$(mrg show xdc $xdc | tail -n +2 | awk '{print $3}')
        if [[ "$attached_val" == "$mzid" ]]; then
            echo "XDC $xdc is attached to $mzid."
            return 0
        fi

        echo "XDC $xdc is not yet attached to $mzid (attempt $attempt of $max_tries)."
        attempt=$(( attempt + 1 ))
    done

    echo "Error: Unable to confirm that XDC $xdc is attached to $mzid after $max_tries attempts."
    return 1
}

# sleep here because sometimes if we try to attach too early it doesn't work
sleep 60
echo Checking XDC attachment...
#xdc=$(hostname | cut -d'.' -f1)
#xdc="${xdc//-/.}"
# this should work for both
# xdc-usc430ejdv.xdc.sphere-testbed.net
# xdc.usc430ejdv-7b7f5f8cff-fjxpm
xdc=$(hostname | sed 's/\./-/g; s/\([^-]*-[^-]*\)-.*/\1/; s/-/./;')

attached=$(mrg list xdc -j | jq -r --arg XDC $xdc '.XDCs[] | select(.name == $XDC).materialization')

if [[ $attached == null || $attached == "" ]] ; then 
    echo XDC is not attached. Attaching to $mzid 
    attach_xdc $xdc $mzid
    if [[ $? -ne 0 ]]; then 
        echo Unable to attach XDC $xdc to $mzid 
        echo Please contact your professor, TA, or Merge testbed OPs. 
        exit 1
    fi
else
    # attached to something.
    if [[ $attached != $mzid || ($attached == $mzid && $remat -eq 1) ]]; then 
        # not attached to our mtz or a stale mtz
        echo Detaching XDC from $attached
        mrg xdc detach $xdc
        if [[ $? -ne 0 ]]; then 
            echo Unable to detach XDC. 
            echo Please contact your professor, TA, or Merge testbed OPs. 
            exit 1
        fi
        
        sleep 3 # give it a bit to detach.

        # ..and attach to our mtz.
        echo Attaching XDC to $mzid 
        attach_xdc $xdc $mzid
        if [[ $? -ne 0 ]]; then 
            echo Unable to attach XDC to $mzid 
            echo Please contact your professor, TA, or Merge testbed OPs. 
            exit 1
        fi
    else 
        # Already attached to current mtz
        echo XDC already attached to current materialization $mzid
    fi
fi

if [ $run -eq 1 ] ; then
    runlab $org $lab
fi

# Everything above either succeeded or exited 1 explicitly on failure, so if
# we reach this point the run was successful. Exit 0 explicitly rather than
# letting the script's exit code fall through to whatever the last internal
# command happened to return (mrg can leave a stray nonzero status behind
# from its own internal jq/status-rendering calls even on a successful
# operation, e.g. the "XDC not ready yet" / already-attached case).
exit 0
