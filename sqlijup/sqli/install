#!/bin/bash

# Creating the pathname(s).
export RESOURCES="/tmp/sqli/resources"
export CHECKER="/home/.checker"

# The username is required for this lab.
export USER=umdclasscdxx

# Avoid interactive prompts during apt installs.
export DEBIAN_FRONTEND=noninteractive

# Installing the required libraries.
apt-get update
apt-get install -y gcc apache2 apache2-bin mariadb-server mariadb-client \
    php libapache2-mod-php php-cli php-mysql libmariadb-dev

# Python libraries for the checker scripts.
if ! apt-get install -y python3-mysql.connector python3-requests; then
    echo "apt packages not available; falling back to pip."
    apt-get install -y python3-pip
    python3 -m pip install --break-system-packages mysql-connector-python requests
fi

# Make sure the database server is running before we use it later.
start_service() {
    if [ -d /run/systemd/system ]; then
        systemctl start "$1" || true
    else
        service "$1" start || true
    fi
}
start_service mariadb

# Moving the checker scripts over.
mkdir -p "$CHECKER"
chown "$USER" "$CHECKER"
cp "$RESOURCES"/checker/* "$CHECKER"

# Moving the save/load scripts.
cp "$RESOURCES"/*sqli.sh "$CHECKER"

# Moving into the /home/.checker directory.
pushd "$CHECKER"

# Compiling the .c files.
gcc -o check_sql check_sql.c

# Removing the .c files so that it's just binaries.
rm -f check_sql.c

# Return to the previous directory.
popd

# Now, go into the /tmp/sqli/resources/web_files directory.
cd "$RESOURCES/web_files" || exit 1

### Installing FCCU.php.
mkdir -p /var/www/html /usr/lib/cgi-bin
cp index.html php_practice.php /var/www/html/
cp FCCU.php /usr/lib/cgi-bin/

# Creating a copy of FCCU.php in the tmp directory. In case students want to reset their file.
# (Might want to change this later.)
cp FCCU.php /tmp

# Giving ownership to the student for php_practice.php and FCCU.php.
chown "$USER" /var/www/html/php_practice.php
chown "$USER" /usr/lib/cgi-bin/FCCU.php

# Create the responses directory.
mkdir -p "$CHECKER/responses"

# Giving ownership to the students so that the checker will work.
chown -R "$USER" "$CHECKER"

# Remove the password for root so that the checker will work.
mysql -e "ALTER USER 'root'@'localhost' IDENTIFIED BY '';"

# Creating the FCCU database.
mysql < fccu.sql

# Turn PHP errors on so that students will not get stuck.
# The glob avoids hardcoding the PHP version in the path.
for ini in /etc/php/*/apache2/php.ini; do
    [ -f "$ini" ] && sed -i 's/^display_errors = Off/display_errors = On/' "$ini"
done

# Required for getting the cgi-bin URL to work.
a2enmod cgi

# Restart Apache (falls back to `service` if systemd isn't running, e.g. in a container).
if [ -d /run/systemd/system ]; then
    systemctl restart apache2
else
    service apache2 restart
fi

# Make the responses directory writeable so that the wire_log.txt file can be made.
chmod o+w "$CHECKER/responses"

# Clean up.
rm -rf ./*